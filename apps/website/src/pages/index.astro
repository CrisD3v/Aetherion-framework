---
import LandingLayout from '../layouts/LandingLayout.astro';
import Navbar from '../components/landing/Navbar.astro';
import Hero from '../components/landing/Hero.astro';
import { CodeTabs } from '../components/landing/CodeTabs.tsx';
import SocialProof from '../components/landing/SocialProof.astro';
import Features from '../components/landing/Features.astro';
import { CopyBlock } from '../components/landing/CopyBlock.tsx';
import { FaqAccordion } from '../components/landing/FaqAccordion.tsx';
import FinalCta from '../components/landing/FinalCta.astro';
import Footer from '../components/landing/Footer.astro';
---

<LandingLayout 
  title="Aetherion Framework | The Next Era of Serverless"
  description="A highly opinionated, decorator-driven TypeScript framework that unifies your logic and infrastructure."
>
  {/* 1. Navbar (Interactive) */}
  <Navbar />

  <main class="flex-1 flex flex-col">
    {/* 2. Hero */}
    <Hero />

    {/* 3. Visual de terminal o código (Interactive) */}
    <section class="pb-20 relative z-20 -mt-10 px-6">
      <CodeTabs client:only="react" />
    </section>

    {/* 4. Social proof */}
    <SocialProof />

    {/* 5. Features en tarjetas */}
    <Features />

    {/* 7. Sección de código con botón copiar (Interactive) */}
    <section class="px-6">
      <CopyBlock client:only="react" />
    </section>


    {/* 10. FAQ interactivo (Interactive) */}
    <section class="py-24 md:py-32 px-6 bg-[#090e16]">
      <div class="mx-auto max-w-[1200px]">
        <div class="text-center mb-16">
          <h2 data-i18n-key="faq.title" class="text-[32px] md:text-[40px] font-semibold tracking-[-1.6px] text-white">
            Frequently Asked Questions
          </h2>
        </div>
        <FaqAccordion client:only="react" />
      </div>
    </section>

    {/* 9 & 11. Pricing / CTA final */}
    <FinalCta />
  </main>

  {/* 12. Footer completo */}
  <Footer />
</LandingLayout>
