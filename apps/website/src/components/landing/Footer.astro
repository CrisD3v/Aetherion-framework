---
import { siteConfig } from '../../data/landing';
---
<footer class="border-t border-[#30353b] bg-[#090e16] py-16">
  <div class="mx-auto max-w-[1200px] px-6">
    <div class="flex flex-col md:flex-row justify-between items-start gap-12">
      <div class="max-w-xs">
        <a href="/" class="flex items-center gap-2 mb-4">
          <div class="w-6 h-6 rounded-md bg-gradient-to-br from-purple-500 to-purple-700 flex items-center justify-center">
            <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <span class="font-semibold text-lg text-white tracking-tight">Aetherion</span>
        </a>
        <p class="text-[14px] text-[#666666] mb-6">
          The decorator-driven Serverless Framework for the Next Era.
        </p>
      </div>

      <div class="flex gap-16">
        <div>
          <h4 class="text-[14px] font-semibold text-white mb-4">Resources</h4>
          <ul class="flex flex-col gap-3 text-[14px] text-[#9ba0a6]">
            <li><a href={siteConfig.links.docs} class="hover:text-white transition-colors">Documentation</a></li>
            <li><a href="/docs/getting-started/quickstart" class="hover:text-white transition-colors">Quick Start</a></li>
            <li><a href="/docs/core/decorators" class="hover:text-white transition-colors">Core Concepts</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-[14px] font-semibold text-white mb-4">Company</h4>
          <ul class="flex flex-col gap-3 text-[14px] text-[#9ba0a6]">
            <li><a href={siteConfig.links.github} class="hover:text-white transition-colors">GitHub</a></li>
            <li><a href="https://twitter.com" class="hover:text-white transition-colors">Twitter</a></li>
            <li><a href="#" class="hover:text-white transition-colors">Blog</a></li>
          </ul>
        </div>
      </div>
    </div>
    
    <div class="mt-16 pt-8 border-t border-[#30353b] flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-[14px] text-[#666666]">
        &copy; {new Date().getFullYear()} Aetherion Framework. All rights reserved.
      </p>
      <div class="flex items-center gap-2">
        <span class="flex h-2 w-2 rounded-full bg-green-500"></span>
        <span class="text-[14px] text-[#666666]">All systems operational</span>
      </div>
    </div>
  </div>
</footer>
