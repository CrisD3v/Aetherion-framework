---
import { siteConfig } from '../../data/landing';
import { ChevronRight } from 'lucide-react';
---

<section class="relative pt-40 pb-20 md:pt-48 md:pb-32 overflow-hidden border-b border-[#1f242b] bg-[#090d13]">
  
  <div class="mx-auto max-w-[1200px] px-6 relative z-10 flex flex-col items-center text-center">
    
    <a href={siteConfig.links.docs} class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#161b22] border border-[#30353b] text-[13px] font-medium text-[#7d8590] hover:text-[#e6edf3] hover:border-[#8b949e] transition-colors mb-8 group shadow-sm">
      <span class="w-2 h-2 rounded-full bg-purple-500 animate-pulse shadow-[0_0_8px_rgba(168,85,247,0.8)]"></span>
      <span data-i18n-key="hero.badge">Introducing Aetherion v1.0 Alpha</span>
      <ChevronRight className="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
    </a>

    <h1 class="text-[48px] leading-[1.1] md:text-[76px] font-bold tracking-[-3.6px] text-[#e6edf3] max-w-4xl mb-6">
      <span data-i18n-key="hero.title">Serverless Infrastructure,</span> <br/>
      <span data-i18n-key="hero.titleHighlight" class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-600">Defined by Logic.</span>
    </h1>

    <p data-i18n-key="hero.subtitle" class="text-[18px] md:text-[20px] text-[#7d8590] max-w-2xl mb-10 leading-relaxed font-medium">
      Banish the Lambdalith. A highly opinionated, decorator-driven TypeScript framework that maps every controller directly to a 1:1 isolated AWS Lambda via CDKTF.
    </p>

    <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
      <a href={siteConfig.links.docs} data-i18n-key="hero.cta.build" class="w-full sm:w-auto flex items-center justify-center px-8 py-3 rounded-md bg-[#e6edf3] text-black text-[15px] font-semibold hover:bg-white hover:scale-[1.02] transition-all shadow-[0_0_20px_rgba(230,237,243,0.1)]">
        Start Building
      </a>
      <a href={siteConfig.links.github} data-i18n-key="hero.cta.github" target="_blank" rel="noreferrer" class="w-full sm:w-auto flex items-center justify-center px-8 py-3 rounded-md bg-[#21262d] border border-[#30363d] text-[#e6edf3] text-[15px] font-semibold hover:bg-[#30363d] transition-all gap-2">
        View on GitHub
      </a>
    </div>
  </div>
</section>
